# Aira — demo-phase live services (client-side EXPO_PUBLIC_* vars).
#
# Copy this file to `.env.local` (gitignored) and fill in real values for a LOCAL run.
# With any block left blank, that service degrades to its on-device MOCK and the app shows a
# calm "demo services not configured" notice — it never crashes.
#
# NOTE: only the Supabase *publishable* (anon) key belongs here — it is client-safe by design.
# Never put a Supabase service-role/secret key in an EXPO_PUBLIC_ var.

# Accounts — Supabase (create-account + login run against the project). Email confirmation is OFF.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Transcription + summarization — Groq (whisper-large-v3 + llama-3.3-70b-versatile).
EXPO_PUBLIC_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_GROQ_BASE_URL=https://api.groq.com/openai/v1
